generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Accountstatus enum
enum UserStatus {
  ACTIVE // default
  BANNED // banned by admin
  LOCKED // account (temp) deactivated
  PENDING // user requested account deletion
  DELETED // data deleted, user record kept for login feedback
}

// User-Avatar enum
enum UserAvatar {
  DEFAULT_AVATAR
  avatar_robot
  avatar_mesh_r
  avatar_mesh_y
  avatar_mesh_p
}

enum UserRestrictionType {
  LOCK
  BAN
}

enum AuditActorType {
  ADMIN
  USER
  SYSTEM
}

enum ServiceRuntimeName {
  MAIN_APP
  ADMIN_BACKEND
}

enum ReportedContentType {
  FILE
  BIN
}

model User {
  id          String     @id @default(uuid())
  username    String     @unique @db.VarChar(50)
  password    String     @db.VarChar(100)
  avatar      UserAvatar @default(DEFAULT_AVATAR)
  status      UserStatus @default(ACTIVE) // accountstatus enum
  sessionKey  String     @default(uuid())
  createdAt   DateTime   @default(now())
  issuedCodes Int        @default(0) // amount of codes the user made

  generatedCodes InviteCode[]    @relation("GeneratedBy")
  files          File[]
  links          Link[]
  bins           Bin[]
  inbox          Mail[]
  blockedSenders BlockedSender[]
  restrictions   UserRestriction[]
  deletionRequests UserDeletionRequest[]
  auditLogs      AdminAuditLog[]     @relation("AuditTargetUser")
  contentReports ContentReport[]     @relation("ReportedContentOwner")

  encryptedMasterKey String? @db.Text
  masterKeyIv        String? @db.VarChar(50)
  masterKeySalt      String? @db.VarChar(50)

  recoveryPhraseHash         String @db.VarChar(100) // bcrypt Hash of the recovery-phrase (24 words)
  recoveryEncryptedMasterKey String @db.Text // MasterKey, encrypted with recovery-phrase
  recoveryMasterKeyIv        String @db.VarChar(50)
  recoveryMasterKeySalt      String @db.VarChar(50)

  publicKey           String @db.Text // not encrypted
  encryptedPrivateKey String @db.Text // encrypted with AES Masterkey
  privateKeyIv        String @db.VarChar(50)
}

model AdminUser {
  id           String     @id @default(uuid())
  username     String     @unique @db.VarChar(50)
  passwordHash String     @db.VarChar(100)
  avatar       UserAvatar @default(DEFAULT_AVATAR)
  sessionKey   String     @default(uuid())
  createdRestrictions UserRestriction[] @relation("RestrictionCreatedByAdmin")
  auditLogs          AdminAuditLog[]    @relation("AuditActorAdmin")
  resolvedContentReports ContentReport[] @relation("ResolvedContentReports")
}

model InviteCode {
  id      String  @id @default(uuid())
  code    String  @unique @db.VarChar(50)
  usage   Int     @default(1)
  isValid Boolean @default(true)
  userId  String?
  creator User?   @relation("GeneratedBy", fields: [userId], references: [id])
}

model File {
  id           String @id @default(uuid())
  originalName String @db.VarChar(100)
  storageName  String @unique // uuid
  size         Int // size in bytes for check
  mimetype     String // mimetype (e.g. image/jpeg, application/pdf etc...)
  userId       String
  user         User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  expiresAt DateTime

  shareToken   String  @unique @default(uuid())
  passwordHash String? @db.VarChar(100)
  contentReports ContentReport[] @relation("ReportedContentFile")

  encryptedFileKey String @db.Text // File-Secret, encrypted with masterkey
  fileKeyIv        String @db.VarChar(50) // IV for encryption of file-key
}

model Link {
  id          String   @id @default(uuid())
  originalUrl String   @db.Text
  shortCode   String   @unique @db.VarChar(10)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Bin {
  id      String  @id @default(uuid())
  title   String? @db.VarChar(100)
  content String  @db.MediumText // text
  size    Int // original-size in bytes

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  shareToken   String    @unique @default(uuid())
  passwordHash String?   @db.VarChar(100)
  contentReports ContentReport[] @relation("ReportedContentBin")

  // e2ee
  encryptedBinKey String @db.Text
  binKeyIv        String @db.VarChar(50)
}

model Mail {
  id          String           @id @default(uuid())
  subject     String?          @db.VarChar(255)
  from        String           @db.VarChar(255)
  to          String           @db.VarChar(255)
  storageKey  String           @unique // name of file in MinIO
  contentSize Int              @default(0) // decrypted mail body size in bytes for quota tracking
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  createdAt   DateTime         @default(now())
  attachments MailAttachment[]

  isRead     Boolean @default(false)
  isArchived Boolean @default(false)
  isSpam     Boolean @default(false)

  encryptedMailKey String @db.Text
  mailKeyIv        String @db.VarChar(50)
}

model BlockedSender {
  id        String   @id @default(uuid())
  email     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, email])
}

model MailAttachment {
  id         String @id @default(uuid())
  filename   String @db.VarChar(255)
  mimetype   String @db.VarChar(100)
  size       Int
  storageKey String @unique // name in MinIO/S3

  mailId String
  mail   Mail   @relation(fields: [mailId], references: [id], onDelete: Cascade)
}

model UserRestriction {
  id                   String              @id @default(uuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 UserRestrictionType
  reason               String              @db.VarChar(500)
  isPermanent          Boolean             @default(false)
  expiresAt            DateTime?
  createdByAdminUserId String?
  createdByAdminUser   AdminUser?          @relation("RestrictionCreatedByAdmin", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  resolvedAt           DateTime?

  @@index([userId, type, resolvedAt])
}

model UserDeletionRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt   DateTime @default(now())
  deleteAfterAt DateTime
  cancelledAt   DateTime?
  processedAt   DateTime?

  @@index([userId, cancelledAt, processedAt])
}

model AdminAuditLog {
  id             String         @id @default(uuid())
  actorType      AuditActorType @default(ADMIN)
  adminUserId    String?
  adminUser      AdminUser?     @relation("AuditActorAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  targetUserId   String?
  targetUser     User?          @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  action         String         @db.VarChar(100)
  previousStatus UserStatus?
  newStatus      UserStatus?
  reason         String?        @db.VarChar(500)
  meta           Json?
  createdAt      DateTime       @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model ServiceRuntime {
  service         ServiceRuntimeName @id
  startedAt       DateTime
  lastHeartbeatAt DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([lastHeartbeatAt])
}

model AdminStorageSnapshot {
  id            String   @id @default(uuid())
  uploadsBytes  BigInt   @default(0)
  mailBytes     BigInt   @default(0)
  binsBytes     BigInt   @default(0)
  totalUsedBytes BigInt  @default(0)
  recordedAt    DateTime @default(now())

  @@index([recordedAt])
}

model ContentReport {
  id                   String              @id @default(uuid())
  contentType          ReportedContentType
  reportedUserId       String
  reportedUser         User                @relation("ReportedContentOwner", fields: [reportedUserId], references: [id])
  fileId               String?
  file                 File?               @relation("ReportedContentFile", fields: [fileId], references: [id], onDelete: SetNull)
  binId                String?
  bin                  Bin?                @relation("ReportedContentBin", fields: [binId], references: [id], onDelete: SetNull)
  contentLink          String              @db.Text
  reason               String              @db.Text
  reporterEmail        String?             @db.VarChar(255)
  createdAt            DateTime            @default(now())
  resolvedAt           DateTime?
  actionTaken          String?             @db.VarChar(500)
  resolvedByAdminUserId String?
  resolvedByAdminUser  AdminUser?          @relation("ResolvedContentReports", fields: [resolvedByAdminUserId], references: [id], onDelete: SetNull)

  @@index([reportedUserId])
  @@index([fileId])
  @@index([binId])
  @@index([createdAt])
  @@index([resolvedAt])
  @@index([resolvedByAdminUserId])
}
