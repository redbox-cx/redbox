// after every change: "npx prisma migrate dev --name description" !!

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Accountstatus enum
enum UserStatus {
  ACTIVE // default
  BANNED // banned by admin
  LOCKED // account (temp) deactivated
}

// Accountrolle enum
enum UserRole {
  USER // default
  ADMIN // all perms
}

// User-Avatar enum
enum UserAvatar {
  DEFAULT_AVATAR
  avatar_robot
  avatar_mesh_r
  avatar_mesh_y
  avatar_mesh_p
}

model User {
  id          String     @id @default(uuid())
  username    String     @unique @db.VarChar(50)
  password    String     @db.VarChar(100)
  avatar      UserAvatar @default(DEFAULT_AVATAR)
  status      UserStatus @default(ACTIVE) // accountstatus enum
  role        UserRole   @default(USER) // accountrole enum
  sessionKey  String     @default(uuid())
  createdAt   DateTime   @default(now())
  issuedCodes Int        @default(0) // amount of codes the user made

  generatedCodes InviteCode[]    @relation("GeneratedBy")
  files          File[]
  links          Link[]
  bins           Bin[]
  inbox          Mail[]
  blockedSenders BlockedSender[]

  encryptedMasterKey String? @db.Text
  masterKeyIv        String? @db.VarChar(50)
  masterKeySalt      String? @db.VarChar(50)

  recoveryPhraseHash         String @db.VarChar(100) // bcrypt Hash of the recovery-phrase (25 words)
  recoveryEncryptedMasterKey String @db.Text // MasterKey, encrypted with recovery-phrase
  recoveryMasterKeyIv        String @db.VarChar(50)
  recoveryMasterKeySalt      String @db.VarChar(50)
}

model InviteCode {
  id      String  @id @default(uuid())
  code    String  @unique @db.VarChar(50)
  usage   Int     @default(1)
  userId  String?
  creator User?   @relation("GeneratedBy", fields: [userId], references: [id])
}

model File {
  id           String @id @default(uuid())
  originalName String @db.VarChar(100)
  storageName  String @unique // uuid
  size         Int // size in bytes for check
  mimetype     String // mimetype (e.g. image/jpeg, application/pdf etc...)
  userId       String
  user         User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  expiresAt DateTime

  shareToken   String  @unique @default(uuid())
  passwordHash String? @db.VarChar(100)

  encryptedFileKey String @db.Text // File-Secret, encrypted with masterkey
  fileKeyIv        String @db.VarChar(50) // IV for encryption of file-key
}

model Link {
  id          String   @id @default(uuid())
  originalUrl String   @db.Text
  shortCode   String   @unique @db.VarChar(10)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Bin {
  id      String  @id @default(uuid())
  title   String? @db.VarChar(100)
  content String  @db.MediumText // text
  size    Int // original-size in bytes

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  shareToken   String    @unique @default(uuid())
  passwordHash String?   @db.VarChar(100)

  // e2ee
  encryptedBinKey String @db.Text
  binKeyIv        String @db.VarChar(50)
}

model Mail {
  id         String   @id @default(uuid())
  subject    String?  @db.VarChar(255)
  from       String   @db.VarChar(255)
  to         String   @db.VarChar(255)
  storageKey String   @unique // name of file in MinIO
  isRead     Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  isArchived Boolean @default(false)
  isSpam     Boolean @default(false)
}

model BlockedSender {
  id        String   @id @default(uuid())
  email     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, email])
}
