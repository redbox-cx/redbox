# --- DATABASE ---
DATABASE_URL="mysql://redbox:replace-with-db-password@mysql:3306/redbox_db"

# --- AUTH (ACCESS TOKEN) ---
JWT_ACCESS_SECRET="replace-with-64-random-bytes-base64url"
EXPIRES_IN_ACCESS=5m

# --- AUTH (REFRESH TOKEN) ---
JWT_REFRESH_SECRET="replace-with-different-64-random-bytes-base64url"
EXPIRES_IN_REFRESH=1d

# --- AUTH (REACTIVATION TOKEN) ---
JWT_REACTIVATION_SECRET="replace-with-different-64-random-bytes-base64url"
EXPIRES_IN_REACTIVATION=15m

# --- INTERNAL SERVICE AUTH ---
INTERNAL_SERVICE_SECRET="123"

# --- ADMIN AUTH ---
ADMIN_JWT_ACCESS_SECRET="replace-with-different-64-random-bytes-base64url"
ADMIN_EXPIRES_IN_ACCESS=5m
ADMIN_JWT_REFRESH_SECRET="replace-with-different-64-random-bytes-base64url"
ADMIN_EXPIRES_IN_REFRESH=5h

# --- SERVER ---
PORT=3000
ADMIN_PORT=3001
FRONTEND_ORIGIN="http://localhost:5173"
ADMIN_FRONTEND_ORIGIN="http://localhost:5173"
# Larger JSON limit for Markdown blog posts sent through the admin API.
ADMIN_BLOG_BODY_LIMIT="10mb"

# cloudflared should be the only trusted proxy source. Set this to the
# Docker network CIDR or the exact cloudflared container IP/CIDR.
TRUSTED_PROXY_CIDRS="172.18.0.0/16"

# --- REDIS ---
REDIS_PASSWORD="replace-with-strong-redis-password"
REDIS_URL="redis://:replace-with-strong-redis-password@127.0.0.1:6379"

# --- SHORTENED LINK-LIMIT ---
LINK_LIMIT=25

# --- UPLOAD-BIN-LIMIT ---
BIN_LIMIT=100

# --- ADMIN DASHBOARD STORAGE LIMIT ---
# Optional: used by the admin dashboard to calculate storage usage percentages.
# Supports raw bytes or units like 500GB / 2TB.
ADMIN_STORAGE_LIMIT="2TB"
# Optional: local MinIO data path for automatic filesystem capacity detection.
# Example on the current docker-compose setup: C:/redbox-minio
ADMIN_STORAGE_PATH="C:/redbox-minio"

# --- Cloudflare Mail Secret ---
MAIL_WEBHOOK_SECRET="replace-with-64-random-bytes-base64url"
# Regular mailbox username that receives admin-forwarded incoming mail and gets the 50GB mail quota.
MAIL_ADMIN_FORWARD_USERNAME="admin"
MAIL_ADMIN_FORWARD_ALIASES="admin@redbox.cx,support@redbox.cx,contact@redbox.cx,no-reply@redbox.cx,help@redbox.cx,team@redbox.cx,moderation@redbox.cx,about@redbox.cx,redbox@redbox.cx"

# --- REPORTS ---
REPORT_CONTENT_SECRET="replace-with-different-64-random-bytes-base64url"

# --- MINIO (S3) ---
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="replace-with-minio-access-key"
S3_SECRET_KEY="replace-with-minio-secret-key"
S3_BUCKET_FILES="redbox-files"
S3_BUCKET_MAILS="redbox-mails"
S3_BUCKET_BLOGS="redbox-blogs"

# --- SEED ---
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="replace-with-strong-initial-admin-password"
