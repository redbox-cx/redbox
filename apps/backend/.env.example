# --- DATABASE ---
# root_password must be the same as in docker-compose file
DATABASE_URL="mysql://root:root_password@localhost:3306/redbox_db"

# --- AUTH (ACCESS TOKEN) ---
JWT_ACCESS_SECRET="dev_access_secret_key"
EXPIRES_IN_ACCESS=5m

# --- AUTH (REFRESH TOKEN) ---
JWT_REFRESH_SECRET="dev_refresh_secret_key"
EXPIRES_IN_REFRESH=1d

# --- AUTH (REACTIVATION TOKEN) ---
# Optional: falls back to JWT_ACCESS_SECRET if omitted
JWT_REACTIVATION_SECRET="dev_reactivation_secret_key"
EXPIRES_IN_REACTIVATION=15m

# --- SERVER ---
PORT=3000
ADMIN_PORT=3001
FRONTEND_ORIGIN="http://localhost:5173"
ADMIN_FRONTEND_ORIGIN="http://localhost:5173"
# Larger JSON limit for Markdown blog posts sent through the admin API.
ADMIN_BLOG_BODY_LIMIT="10mb"

# --- SHORTENED LINK-LIMIT ---
LINK_LIMIT=25

# --- UPLOAD-BIN-LIMIT ---
BIN_LIMIT=100

# --- ADMIN DASHBOARD STORAGE LIMIT ---
# Optional: used by the admin dashboard to calculate storage usage percentages.
# Supports raw bytes or units like 500GB / 2TB.
ADMIN_STORAGE_LIMIT="2TB"
# Optional: local MinIO data path for automatic filesystem capacity detection.
# Example on the current docker-compose setup: C:/redbox-minio
ADMIN_STORAGE_PATH="C:/redbox-minio"

# --- Cloudflare Mail Secret ---
MAIL_WEBHOOK_SECRET="xLNi2J7*J9umX4up*uRzsuBHqpsHG59e%8PMCE@4a$VFVKdVgs"

# --- MINIO (S3) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="admin_redbox"
S3_SECRET_KEY="SuperSecretMinioPassword123"
S3_BUCKET_FILES="redbox-files"
S3_BUCKET_MAILS="redbox-mails"
# Optional: falls back to S3_BUCKET_FILES if omitted.
S3_BUCKET_BLOGS="redbox-files"

# --- SEED ---
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="admin"
