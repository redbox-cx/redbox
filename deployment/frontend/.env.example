# Redbox frontend LXC deployment environment.
# Copy this file to deployment/frontend/.env on the frontend LXC and replace every CHANGE_ME value.

# This value is compiled into the Vite frontend at image build time.
VITE_API_URL="https://api.redbox.cx/api/v1"

# --- CLOUDFLARE TUNNEL ---
# Tunnel public hostnames:
# redbox.cx     -> http://frontend:80
# www.redbox.cx -> http://frontend:80
CLOUDFLARE_TUNNEL_TOKEN="CHANGE_ME_FRONTEND_CLOUDFLARE_TUNNEL_TOKEN"
