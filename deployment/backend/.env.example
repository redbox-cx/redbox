# Redbox backend LXC deployment environment.
# Copy this file to deployment/backend/.env on the backend LXC and replace every CHANGE_ME value.
# Keep the real .env out of git.

# --- DEPLOYMENT IMAGES (GHCR) ---
GHCR_NAMESPACE="your-github-user-or-organization"
REDBOX_IMAGE_TAG="FULL_40_CHARACTER_COMMIT_SHA"

# --- DATABASE ---
MYSQL_ROOT_PASSWORD="CHANGE_ME_STRONG_MYSQL_ROOT_PASSWORD"
MYSQL_DATABASE="redbox_db"
MYSQL_USER="redbox"
MYSQL_PASSWORD="CHANGE_ME_STRONG_MYSQL_PASSWORD"
DATABASE_URL="mysql://redbox:CHANGE_ME_STRONG_MYSQL_PASSWORD@db:3306/redbox_db"

# --- AUTH (ACCESS TOKEN) ---
JWT_ACCESS_SECRET="CHANGE_ME_64_RANDOM_BYTES_BASE64URL"
EXPIRES_IN_ACCESS=5m

# --- AUTH (REFRESH TOKEN) ---
JWT_REFRESH_SECRET="CHANGE_ME_DIFFERENT_64_RANDOM_BYTES_BASE64URL"
EXPIRES_IN_REFRESH=1d

# --- AUTH (REACTIVATION TOKEN) ---
JWT_REACTIVATION_SECRET="CHANGE_ME_DIFFERENT_64_RANDOM_BYTES_BASE64URL"
EXPIRES_IN_REACTIVATION=15m

# --- INTERNAL SERVICE AUTH ---
INTERNAL_SERVICE_SECRET="CHANGE_ME_DIFFERENT_64_RANDOM_BYTES_BASE64URL"

# --- ADMIN AUTH ---
ADMIN_JWT_ACCESS_SECRET="CHANGE_ME_DIFFERENT_64_RANDOM_BYTES_BASE64URL"
ADMIN_EXPIRES_IN_ACCESS=5m
ADMIN_JWT_REFRESH_SECRET="CHANGE_ME_DIFFERENT_64_RANDOM_BYTES_BASE64URL"
ADMIN_EXPIRES_IN_REFRESH=5h

# --- SERVER ---
PORT=3000
ADMIN_PORT=3001
FRONTEND_ORIGIN="https://redbox.cx"
ADMIN_FRONTEND_ORIGIN="https://admin.redbox.cx"
ADMIN_BLOG_BODY_LIMIT="10mb"

# Must match the Docker subnet in deployment/backend/docker-compose.yaml.
TRUSTED_PROXY_CIDRS="172.29.0.0/16"

# --- CLOUDFLARE TUNNEL ---
# Tunnel public hostnames:
# api.redbox.cx       -> http://backend:3000
# admin-api.redbox.cx -> http://admin-backend:3001
CLOUDFLARE_TUNNEL_TOKEN="CHANGE_ME_BACKEND_CLOUDFLARE_TUNNEL_TOKEN"

# --- REDIS ---
REDIS_PASSWORD="CHANGE_ME_STRONG_REDIS_PASSWORD"
REDIS_URL="redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379"

# --- LIMITS ---
LINK_LIMIT=25
BIN_LIMIT=100

# --- ADMIN DASHBOARD STORAGE LIMIT ---
ADMIN_STORAGE_LIMIT="2TB"
ADMIN_STORAGE_PATH="/data/minio"

# --- CLOUDFLARE MAIL ---
MAIL_WEBHOOK_SECRET="CHANGE_ME_64_RANDOM_BYTES_BASE64URL"
# Regular username that receives admin-forwarded mail and gets the 50GB mail and file quotas.
MAIL_ADMIN_FORWARD_USERNAME="admin"
MAIL_ADMIN_FORWARD_ALIASES="admin@redbox.cx,support@redbox.cx,contact@redbox.cx,no-reply@redbox.cx,help@redbox.cx,team@redbox.cx,moderation@redbox.cx,about@redbox.cx,redbox@redbox.cx"

# --- REPORTS ---
REPORT_CONTENT_SECRET="CHANGE_ME_DIFFERENT_64_RANDOM_BYTES_BASE64URL"

# --- MINIO (S3) ---
MINIO_ROOT_USER="CHANGE_ME_MINIO_ROOT_USER"
MINIO_ROOT_PASSWORD="CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD"
# Storage-level fallback. The backend normally aborts uploads after 1h inactivity.
MINIO_STALE_UPLOADS_EXPIRY="168h"
MINIO_STALE_UPLOADS_CLEANUP_INTERVAL="1h"
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="CHANGE_ME_MINIO_ACCESS_KEY"
S3_SECRET_KEY="CHANGE_ME_MINIO_SECRET_KEY"
S3_BUCKET_FILES="redbox-files"
S3_BUCKET_MAILS="redbox-mails"
S3_BUCKET_BLOGS="redbox-blogs"

# --- OPTIONAL INITIAL ADMIN SEED ---
# This is not executed automatically. Only used if you manually run the seed-admin tool service.
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="CHANGE_ME_STRONG_INITIAL_ADMIN_PASSWORD"
